@section('script')
    <script>
        // Calcul automatique de la caution
        document.addEventListener('DOMContentLoaded', function() {
            const loyerInput = document.getElementById('loyer_mensuel');
            const nombreCautionsInput = document.getElementById('nombre_cautions');
            const cautionInput = document.getElementById('caution');

            function calculerCaution() {
                if (loyerInput && nombreCautionsInput && cautionInput) {
                    const loyer = parseFloat(loyerInput.value) || 0;
                    const nombreCautions = parseFloat(nombreCautionsInput.value) || 0;
                    const caution = loyer * nombreCautions;
                    cautionInput.value = caution.toFixed(2);
                }
            }

            if (loyerInput && nombreCautionsInput) {
                loyerInput.addEventListener('input', calculerCaution);
                nombreCautionsInput.addEventListener('input', calculerCaution);

                // Calcul initial au chargement du modal
                calculerCaution();

                // Recalculer quand le modal s'ouvre
                const modal = document.getElementById('configurerPaiementModal');
                if (modal) {
                    modal.addEventListener('shown.bs.modal', calculerCaution);
                }
            }

            // Gestion du type de commission dans le modal d'ajout de paiement
            const typeCommissionAjout = document.getElementById('type_commission_ajout');
            const commissionInputAjout = document.getElementById('commission_paiement');
            const montantPaiementAjout = document.getElementById('montant_paiement_ajout');
            const calculCommissionAjout = document.getElementById('calcul_commission_ajout');
            const commissionCalculeeAjout = document.getElementById('commission_calculee_ajout');
            const alerteMontantAjout = document.getElementById('alerte_montant_ajout');

            // Gestion des boutons radio pour le type de paiement
            const montantTotalRadio = document.getElementById('montant_total');
            const paiementPartielRadio = document.getElementById('paiement_partiel');
            const montantRestePayer = {{ $resteAPayer }};

            if (montantTotalRadio && paiementPartielRadio && montantPaiementAjout) {
                montantTotalRadio.addEventListener('change', function() {
                    if (this.checked) {
                        montantPaiementAjout.value = montantRestePayer;
                        montantPaiementAjout.readOnly = true;
                        montantPaiementAjout.style.backgroundColor = '#e9ecef';
                        calculerCommissionAjout();
                    }
                });

                paiementPartielRadio.addEventListener('change', function() {
                    if (this.checked) {
                        montantPaiementAjout.value = '';
                        montantPaiementAjout.readOnly = false;
                        montantPaiementAjout.style.backgroundColor = '';
                        montantPaiementAjout.focus();
                        calculerCommissionAjout();
                    }
                });
            }

            function calculerCommissionAjout() {
                console.log('=== calculerCommissionAjout appelée ===');

                if (!typeCommissionAjout || !commissionInputAjout || !calculCommissionAjout || !
                    commissionCalculeeAjout) {
                    console.error('Éléments manquants');
                    return;
                }

                const type = typeCommissionAjout.value;
                const commission = parseFloat(commissionInputAjout.value) || 0;
                const montant = parseFloat(montantPaiementAjout?.value) || 0;

                console.log('Valeurs:', {
                    type,
                    commission,
                    montant
                });

                // Cacher les deux alertes par défaut
                calculCommissionAjout.style.display = 'none';
                if (alerteMontantAjout) alerteMontantAjout.style.display = 'none';

                if (commission > 0) {
                    if (type === 'pourcentage') {
                        const montantCommission = (montant * commission) / 100;
                        console.log('==> Calcul pourcentage:', montantCommission);
                        commissionCalculeeAjout.textContent = montantCommission.toFixed(0).replace(
                            /\B(?=(\d{3})+(?!\d))/g, ' ');
                        calculCommissionAjout.style.display = 'block';

                        // Afficher l'alerte seulement si montant = 0
                        if (montant === 0 && alerteMontantAjout) {
                            alerteMontantAjout.style.display = 'block';
                        }
                    } else {
                        console.log('==> Calcul fixe:', commission);
                        commissionCalculeeAjout.textContent = commission.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g,
                            ' ');
                        calculCommissionAjout.style.display = 'block';
                    }
                }
                console.log('=== Fin calculerCommissionAjout ===\n');
            }

            if (typeCommissionAjout) {
                typeCommissionAjout.addEventListener('change', function() {
                    console.log('Type commission changé:', this.value);
                    const labelElem = document.getElementById('label_commission_ajout');
                    const hintElem = document.getElementById('hint_commission_ajout');

                    if (this.value === 'pourcentage') {
                        labelElem.textContent = 'Pourcentage de commission';
                        hintElem.textContent = 'Ex: 10 pour 10%';
                    } else {
                        labelElem.textContent = 'Montant de commission';
                        hintElem.textContent = 'Montant en FCFA';
                    }
                    calculerCommissionAjout();
                });

                if (commissionInputAjout) {
                    commissionInputAjout.addEventListener('input', function() {
                        console.log('Commission input changé:', this.value);
                        calculerCommissionAjout();
                    });
                }

                if (montantPaiementAjout) {
                    montantPaiementAjout.addEventListener('input', function() {
                        console.log('Montant paiement changé:', this.value);
                        calculerCommissionAjout();
                    });
                }

                // Calcul initial
                setTimeout(() => calculerCommissionAjout(), 100);
            }

            // Gestion du type de commission dans les modals d'édition
            @foreach ($location->paiements ?? [] as $paiement)
                const typeCommissionEdit{{ $paiement->id }} = document.getElementById(
                    'type_commission_edit_{{ $paiement->id }}');
                const commissionInputEdit{{ $paiement->id }} = document.getElementById(
                    'commission_edit_{{ $paiement->id }}');
                const montantPaiementEdit{{ $paiement->id }} = document.getElementById(
                    'montant_paiement_edit_{{ $paiement->id }}');
                const calculCommissionEdit{{ $paiement->id }} = document.getElementById(
                    'calcul_commission_edit_{{ $paiement->id }}');
                const commissionCalculeeEdit{{ $paiement->id }} = document.getElementById(
                    'commission_calculee_edit_{{ $paiement->id }}');
                const alerteMontantEdit{{ $paiement->id }} = document.getElementById(
                    'alerte_montant_edit_{{ $paiement->id }}');

                function calculerCommissionEdit{{ $paiement->id }}() {
                    if (!typeCommissionEdit{{ $paiement->id }} || !commissionInputEdit{{ $paiement->id }} || !
                        calculCommissionEdit{{ $paiement->id }} || !commissionCalculeeEdit{{ $paiement->id }})
                        return;

                    const type = typeCommissionEdit{{ $paiement->id }}.value;
                    const commission = parseFloat(commissionInputEdit{{ $paiement->id }}.value) || 0;
                    const montant = parseFloat(montantPaiementEdit{{ $paiement->id }}?.value) || 0;

                    // Cacher les deux alertes par défaut
                    calculCommissionEdit{{ $paiement->id }}.style.display = 'none';
                    if (alerteMontantEdit{{ $paiement->id }}) alerteMontantEdit{{ $paiement->id }}.style
                        .display = 'none';

                    if (commission > 0) {
                        if (type === 'pourcentage') {
                            const montantCommission = (montant * commission) / 100;
                            commissionCalculeeEdit{{ $paiement->id }}.textContent = montantCommission.toFixed(0)
                                .replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
                            calculCommissionEdit{{ $paiement->id }}.style.display = 'block';

                            // Afficher l'alerte seulement si montant = 0
                            if (montant === 0 && alerteMontantEdit{{ $paiement->id }}) {
                                alerteMontantEdit{{ $paiement->id }}.style.display = 'block';
                            }
                        } else {
                            commissionCalculeeEdit{{ $paiement->id }}.textContent = commission.toFixed(0).replace(
                                /\B(?=(\d{3})+(?!\d))/g, ' ');
                            calculCommissionEdit{{ $paiement->id }}.style.display = 'block';
                        }
                    }
                }

                if (typeCommissionEdit{{ $paiement->id }}) {
                    typeCommissionEdit{{ $paiement->id }}.addEventListener('change', function() {
                        const labelElem = document.getElementById(
                            'label_commission_edit_{{ $paiement->id }}');
                        const hintElem = document.getElementById(
                            'hint_commission_edit_{{ $paiement->id }}');

                        if (this.value === 'pourcentage') {
                            labelElem.textContent = 'Pourcentage de commission';
                            hintElem.textContent = 'Ex: 10 pour 10%';
                        } else {
                            labelElem.textContent = 'Montant de commission';
                            hintElem.textContent = 'Montant en FCFA';
                        }
                        calculerCommissionEdit{{ $paiement->id }}();
                    });

                    commissionInputEdit{{ $paiement->id }}?.addEventListener('input',
                        calculerCommissionEdit{{ $paiement->id }});
                    montantPaiementEdit{{ $paiement->id }}?.addEventListener('input',
                        calculerCommissionEdit{{ $paiement->id }});

                    // Calcul initial
                    calculerCommissionEdit{{ $paiement->id }}();
                }
            @endforeach
        });
    </script>
@endsection
