                                    <div class="mb-3">
                                        <label class="form-label">
                                            <span id="label_commission_edit_{{ $paiement->id }}">
                                                {{ $paiement->type_commission == 'pourcentage' ? 'Pourcentage de commission' : 'Montant de commission' }}
                                            </span>
                                        </label>
                                        <input type="number" name="commission_agence"
                                            id="commission_edit_{{ $paiement->id }}" class="form-control"
                                            value="{{ $paiement->commission_agence ?? 0 }}" step="0.01"
                                            min="0" placeholder="0">
                                        <small class="text-muted">
                                            <span id="hint_commission_edit_{{ $paiement->id }}">
                                                {{ $paiement->type_commission == 'pourcentage' ? 'Ex: 10 pour 10%' : 'Montant en FCFA' }}
                                            </span>
