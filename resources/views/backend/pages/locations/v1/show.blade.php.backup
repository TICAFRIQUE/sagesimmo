                                    </h6>

                                    <div class="mb-3">
                                        <label class="form-label">Type de commission</label>
                                        <select name="type_commission" id="type_commission_edit_{{ $paiement->id }}"
                                            class="form-select">
                                            <option value="fixe"
                                                {{ ($paiement->type_commission ?? 'fixe') == 'fixe' ? 'selected' : '' }}>
                                                Montant fixe (FCFA)</option>
                                            <option value="pourcentage"
                                                {{ $paiement->type_commission == 'pourcentage' ? 'selected' : '' }}>
                                                Pourcentage (%)</option>
                                        </select>
